# Optional environment; keep actual secrets private.
# The first BOT_TOKENS entry is the main bot. Use this OR TOKEN_LIST OR tokens.txt.
# BOT_TOKENS=["PUT_MAIN_BOT_TOKEN_HERE","PUT_SECOND_BOT_TOKEN_HERE"]
# OWNER_ID=YOUR_DISCORD_USER_ID
# DATA_DIR=/absolute/path/to/persistent/data
# STORAGE_BACKEND=sqlite
# WEB_PLAYER_PUBLIC_URL=https://music.example.com
# CLOUDFLARE_TUNNEL_TOKEN=PUT_PRIVATE_NAMED_TUNNEL_TOKEN_HERE

# Optional Windows/PM2 interpreter; no global Node installation is changed.
# MUSIC_NODE_EXECUTABLE=C:\Program Files\nodejs\node.exe
# NODE_HEAP_MB=7168
# FLEET_SHUTDOWN_TIMEOUT_MS=30000
